QWidget {
    background: #FFFFFF;
    alternate-background-color: #DEE4E7;
    selection-background-color: #37474F;
    font-family: 'Lato', sans-serif;
    color: #37474F;
}

QMenu {
    background: #37474F;
    color: #FFFFFF;
}

QMenu::item:selected {
    color: #37474F;
    background: #FFFFFF;
}

QComboBox::item:selected {
    background: #37474F;
    color: #FFFFFF;
}

QPushButton {
    background-color: #E7EDEE;
    color: #263B40;
    border: 1px solid #B9C9CD;
    border-radius: 4px;
    selection-background-color: #37474F;
    padding: 4px 8px;
}

QPushButton::hover {
    background-color: #46646B;
    color: #FFFFFF;
    border-color: #37474F;
}

QPushButton::pressed {
    background-color: #2F454A;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #F1F3F3;
    color: #93A1A4;
    border-color: #D7DFE1;
}

QComboBox {
    background-color: #FFFFFF;
    color: #263B40;
    border: 1px solid #AEBFC3;
    border-radius: 4px;
    padding: 3px 7px;
}

QComboBox:hover, QComboBox:focus {
    border-color: #46646B;
}

QComboBox:disabled {
    background-color: #F1F3F3;
    color: #93A1A4;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #263B40;
    border: 1px solid #AEBFC3;
    selection-background-color: #37474F;
    selection-color: #FFFFFF;
}

QTabBar::tab {
    background: #37474F;
    color: #DEE4E7;
    padding: 10px;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    color: #37474F;
    background: #FFFFFF;
}

QTabBar::tab:top {
    border-top: 2px outset #37474F;
    border-left: 1px inset #37474F;
    border-right: 1px inset #37474F;
}

QTabBar::tab:bottom {
    border-bottom: 2px outset #37474F;
    border-left: 1px inset #37474F;
    border-right: 1px inset #37474F;
}

QTabBar::tab:left {
    border-left: 2px outset #37474F;
    border-top: 1px inset #37474F;
    border-bottom: 1px inset #37474F;
}

QTabBar::tab:right {
    border-right: 2px outset #37474F;
    border-top: 1px inset #37474F;
    border-bottom: 1px inset #37474F;
}

QDockWidget {
    background: #37474F;
    color: #DEE4E7;
    padding: 0;
    margin: 0;
}

QDockWidget > QWidget {
    background: #FFFFFF;
    border: 1px;
    border-style: solid;
    border-color: #DEE4E7;
}

QDockWidget::title {
    text-align: left;
    background: #37474F;
    color: #DEE4E7;
}

QMenuBar {
    background: #FFFFFF;
    color: #37474F;
}

QTextBrowser {
    font-family: "Lato"
}

/* Main workspace */
QMdiArea {
    background: qradialgradient(cx: 0.5, cy: 0.2, radius: 1.1,
        stop: 0 #F8FAFA, stop: 0.55 #EEF2F3, stop: 1 #D9E1E3);
}

QMdiSubWindow {
    background: #FFFFFF;
    border: 1px solid #B8C6C9;
    border-radius: 6px;
}

QMdiSubWindow:focus {
    border: 2px solid #3F6970;
}

QMdiArea QTabBar {
    background: #E4EAEB;
    qproperty-drawBase: 0;
}

QMdiArea QTabBar::tab {
    background: #D6E0E2;
    color: #40565B;
    border: 1px solid #C2D0D3;
    border-bottom: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin: 5px 2px 0 2px;
    padding: 8px 18px;
}

QMdiArea QTabBar::tab:selected {
    background: #FFFFFF;
    color: #23383D;
    border-color: #8EA6AB;
}

QMdiArea QTabBar::tab:hover:!selected {
    background: #EAF0F1;
}

QMdiArea QTabBar::close-button:hover {
    background: #C95C54;
    border-radius: 7px;
}

QDockWidget::title {
    padding: 7px 10px;
    font-weight: 600;
}
